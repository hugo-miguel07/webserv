# Run from the repository root. directory -> YoupiBanane is already present.
server {
    listen 8081;
    server_name localhost 127.0.0.1;
    root www;
    index index.html;
    client_max_body_size 100M;

    location / {
        allow_methods GET;
    }

    location /directory {
        root .;
        allow_methods GET;
        index youpi.bad_extension;
        autoindex off;
    }

    location .bla {
        allow_methods GET POST;
        cgi_extension .bla;
        cgi_path ./cgi_tester;
    }

    location /post_body {
        allow_methods POST;
        client_max_body_size 100;
        return 200 OK;
    }
}
