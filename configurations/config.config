server {
    listen 8081;
    root www;
    client_max_body_size 9K;
    server_name localhost;
    index index.html;

    error_page 400 /errors/400.html;
    error_page 500 /errors/500.html;

    location / {
        root www;
        allow_methods GET POST;
        index index.html index.htm index.ht;
    }

    location /old {
        return 301 https://youtube.com;
    }

    location /upload {
        allow_methods POST;
        autoindex off;
        upload_store /var/www/site1/uploads;
    }

    location /cgi-bin {
        allow_methods GET POST;
        cgi_extension .py;
        cgi_path /usr/bin/python3;
        root www;
    }
}

server {
    listen 8080;
    server_name localhost;

    root /var/www/site2;
    index index.html;

    client_max_body_size 5M;

    error_page 404 /404.html;

    location / {
        allow_methods GET;
    }

    location /admin {
        allow_methods GET POST DELETE;
    }
}